# ==========================================
# APP
# ==========================================

APP_ENV=development
PORT=8080
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000


# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres


# ==========================================
# SUPABASE
# ==========================================

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use ONE of these depending on your Supabase JWT configuration
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json


# ==========================================
# CLOUDINARY
# ==========================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ==========================================
# LIVE RATES
# ==========================================

TWELVE_DATA_API_KEY=your_twelve_data_api_key
# 33 pairs x 2/hr x 24h = ~1584/day: over the 800 free credits.
# Use 60 (792/day) on the free plan, 30 only with a higher quota.
RATES_REFRESH_MINUTES=60


# ==========================================
# SECURITY
# ==========================================

BCRYPT_ROUNDS=12

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
JWT_RESET_AT=7d


# ==========================================
# CORS
# ==========================================

CORS_URL=http://localhost:3000